# Settings for the server (docker-compose.prod.yml). Copy to .env and fill in:
#   cp .env.production.example .env
# Every variable is validated when the app starts (src/lib/env-schema.ts).

# Public address of the app, exactly as people type it (https, no trailing
# slash). Used in invitation and sign-in links; passkeys are bound to it.
APP_URL=https://lektionen.example.ch

# Signs sessions and tokens and encrypts the stored SMTP password.
# Generate once: openssl rand -base64 48   (changing it signs everyone out)
AUTH_SECRET=

# Database password (any long random string): openssl rand -base64 32
POSTGRES_PASSWORD=

# nginx on this server reaches the app through the Docker network gateway
# (fixed in docker-compose.prod.yml). Needed so the sign-in lock sees the
# real client IP from X-Forwarded-For.
TRUSTED_PROXIES=172.30.0.1

# Port on 127.0.0.1 that nginx forwards to.
APP_PORT=3000

# --- Optional ---------------------------------------------------------------
# Mail server: normally set in the app (Einstellungen → E-Mail). Only fill
# these in to send the very first invitation by email; otherwise `setup`
# prints the link.
# SMTP_HOST=mail.example.ch
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Lektionsplaner <noreply@example.ch>"

# Sessions and sign-in protection (defaults shown)
# SESSION_IDLE_MINUTES=60
# SESSION_MAX_HOURS=12
# AUTH_MAX_FAILED_SIGNINS=10
# AUTH_LOCKOUT_MINUTES=15

# PDFs rendered at the same time (each needs roughly 100 MB of memory)
# PDF_CONCURRENCY=2
