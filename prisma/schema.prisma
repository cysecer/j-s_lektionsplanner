// Data model for the Lektionsplaner.
//
// Multi-tenant ready: every top-level entity carries a clubId. The app runs
// with a single club for now, but all queries are scoped by club.
//
// Rich-text columns hold the restricted Tiptap JSON format validated by
// src/lib/rich-text/schema.ts; layout configs are validated by
// src/lib/layout/schema.ts. JSON is never written without passing those.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  EASY
  MEDIUM
  DEMANDING
}

enum LessonStatus {
  DRAFT
  FINAL
}

enum CustomFieldType {
  SHORT_TEXT
  LONG_TEXT
  LIST
  NUMBER
  IMAGE
}

/// The three sections every club starts with. Their names are translated;
/// clubs may rename them or add further custom sections.
enum BuiltinSection {
  INTRO
  MAIN
  END
}

model Club {
  id                      String   @id @default(uuid(7)) @db.Uuid
  name                    String
  logoAssetId             String?  @unique @db.Uuid
  /// Optional text in the PDF footer (e.g. "J+S-Kindersport").
  pdfFooterText           String?
  defaultLayoutId         String?  @unique @db.Uuid
  /// Pre-filled into new lessons (minutes after midnight; 1080 = 18:00).
  defaultStartTimeMinutes Int      @default(1080)
  /// Pre-filled planned lesson duration in minutes.
  defaultDurationMinutes  Int      @default(90)
  /// PDFs a reader may create per day (Europe/Zurich calendar day).
  readerPdfDailyLimit     Int      @default(10)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  logo          Asset?         @relation("ClubLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)
  defaultLayout Layout?        @relation("ClubDefaultLayout", fields: [defaultLayoutId], references: [id], onDelete: SetNull)
  teams         Team[]
  coaches       Coach[]
  tags          Tag[]
  sections      Section[]
  customFields  CustomField[]
  layouts       Layout[]
  assets        Asset[]        @relation("ClubAssets")
  programBlocks ProgramBlock[]
  lessons       Lesson[]
  memberships   Membership[]
  invitations   Invitation[]
  pdfExports    PdfExport[]
  mailSettings  MailSettings?
  mailLogs      MailLog[]
}

/// Riege / Abteilung, e.g. "Kids", "TuVo", "Jugi".
model Team {
  id                      String    @id @default(uuid(7)) @db.Uuid
  clubId                  String    @db.Uuid
  name                    String
  sortOrder               Int       @default(0)
  /// Overrides the club default when set (teams often train at other times).
  defaultStartTimeMinutes Int?
  defaultDurationMinutes  Int?
  /// Drafts are visible only to their creator (and admins) until published.
  privateDrafts           Boolean   @default(false)
  /// Archived instead of deleted when lessons still refer to it.
  archivedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  club          Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  coaches       CoachTeam[]
  programBlocks ProgramBlockTeam[]
  lessons       Lesson[]
  activeFor     Membership[]
  memberRoles   MembershipTeam[]
  inviteRoles   InvitationTeam[]

  @@unique([clubId, name])
  @@index([clubId, sortOrder])
}

/// Leiter/-in. Just a name; optionally linked to teams (and later to a user).
model Coach {
  id         String    @id @default(uuid(7)) @db.Uuid
  clubId     String    @db.Uuid
  name       String
  /// Archived instead of deleted when lessons or blocks still refer to it.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  club                Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  teams               CoachTeam[]
  responsibleForItems LessonItem[]
  presentInLessons    LessonCoach[]
  membership          Membership?
  invitations         Invitation[]

  @@unique([clubId, name])
}

model CoachTeam {
  coachId String @db.Uuid
  teamId  String @db.Uuid

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([coachId, teamId])
  @@index([teamId])
}

model Tag {
  id        String   @id @default(uuid(7)) @db.Uuid
  clubId    String   @db.Uuid
  name      String
  createdAt DateTime @default(now())

  club          Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  programBlocks ProgramBlockTag[]

  @@unique([clubId, name])
}

/// A section of a lesson (Einleitung / Hauptteil / Ausklang, or custom).
model Section {
  id        String          @id @default(uuid(7)) @db.Uuid
  clubId    String          @db.Uuid
  /// Set for the three built-in sections; their default names are translated.
  builtin   BuiltinSection?
  /// Custom name. When null, the translated name of `builtin` is shown.
  name      String?
  sortOrder Int             @default(0)

  club            Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  suggestedBlocks ProgramBlock[]
  lessonItems     LessonItem[]

  @@unique([clubId, builtin])
  @@index([clubId, sortOrder])
}

/// Admin-defined extra field on program blocks. Values are stored in
/// ProgramBlock.customValues / LessonItem.customValues keyed by this id.
model CustomField {
  id         String          @id @default(uuid(7)) @db.Uuid
  clubId     String          @db.Uuid
  label      String
  type       CustomFieldType
  sortOrder  Int             @default(0)
  /// Included in the full-text search (text and list types only).
  searchable Boolean         @default(true)
  /// Filterable in the library (short text, number).
  filterable Boolean         @default(false)
  /// Archived fields stay readable in existing lessons but leave editors and layouts.
  archivedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, label])
  @@index([clubId, sortOrder])
}

/// Saved program-block row layout (columns and the fields inside them).
model Layout {
  id        String   @id @default(uuid(7)) @db.Uuid
  clubId    String   @db.Uuid
  name      String
  /// LayoutConfig, see src/lib/layout/schema.ts
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club           Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  defaultForClub Club?    @relation("ClubDefaultLayout")
  lessons        Lesson[]

  @@unique([clubId, name])
}

/// Uploaded image (sketch, logo, custom image field). Immutable once stored,
/// so lesson snapshots can share them with library blocks safely.
model Asset {
  id         String   @id @default(uuid(7)) @db.Uuid
  clubId     String   @db.Uuid
  storageKey String   @unique
  mimeType   String
  width      Int
  height     Int
  byteSize   Int
  createdAt  DateTime @default(now())

  club               Club                 @relation("ClubAssets", fields: [clubId], references: [id], onDelete: Cascade)
  logoOfClub         Club?                @relation("ClubLogo")
  blockSketches      ProgramBlockSketch[]
  lessonItemSketches LessonItemSketch[]

  @@index([clubId])
}

/// Reusable library item (game / exercise).
model ProgramBlock {
  id                 String      @id @default(uuid(7)) @db.Uuid
  clubId             String      @db.Uuid
  title              String
  durationMinutes    Int?
  description        Json?
  rules              Json?
  variations         String[]
  organization       Json?
  material           String[]
  // No responsible person here: it is assigned per lesson item, because
  // who is present differs from training to training.
  suggestedSectionId String?     @db.Uuid
  ageMin             Int?
  ageMax             Int?
  /// Number of teams the game is played in (e.g. 2).
  teamCount          Int?
  /// Group size the block works for.
  minParticipants    Int?
  maxParticipants    Int?
  difficulty         Difficulty?
  /// Values of custom fields, keyed by CustomField.id.
  customValues       Json        @default("{}")
  /// Plain-text concatenation of all searchable content; indexed for
  /// German full-text search (see migration).
  searchText         String      @default("")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  club             Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  suggestedSection Section?             @relation(fields: [suggestedSectionId], references: [id], onDelete: SetNull)
  /// No teams means the block is available club-wide.
  teams            ProgramBlockTeam[]
  tags             ProgramBlockTag[]
  sketches         ProgramBlockSketch[]
  usedInItems      LessonItem[]

  @@index([clubId, title])
  @@index([clubId, durationMinutes])
}

model ProgramBlockTeam {
  blockId String @db.Uuid
  teamId  String @db.Uuid

  block ProgramBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  team  Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([blockId, teamId])
  @@index([teamId])
}

model ProgramBlockTag {
  blockId String @db.Uuid
  tagId   String @db.Uuid

  block ProgramBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  tag   Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blockId, tagId])
  @@index([tagId])
}

model ProgramBlockSketch {
  blockId   String @db.Uuid
  assetId   String @db.Uuid
  sortOrder Int    @default(0)

  block ProgramBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  asset Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([blockId, assetId])
  @@index([assetId])
}

/// Lektionsvorbereitung (training session plan).
model Lesson {
  id                   String       @id @default(uuid(7)) @db.Uuid
  clubId               String       @db.Uuid
  teamId               String?      @db.Uuid
  layoutId             String?      @db.Uuid
  title                String
  authorName           String
  date                 DateTime     @db.Date
  /// Minutes after midnight; when set, clock times are shown per item.
  startTimeMinutes     Int?
  totalDurationMinutes Int?
  location             String?
  ageMin               Int?
  ageMax               Int?
  groupSize            String?
  difficulty           Difficulty?
  safety               Json?
  goals                Json?
  notes                Json?
  status               LessonStatus @default(DRAFT)
  /// Account that created the lesson; null for lessons from before this was recorded.
  createdById          String?      @db.Uuid
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  club           Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team           Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  layout         Layout?       @relation(fields: [layoutId], references: [id], onDelete: SetNull)
  createdBy      User?         @relation("LessonsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  presentCoaches LessonCoach[]
  items          LessonItem[]
  pdfExports     PdfExport[]
  mailLogs       MailLog[]

  @@index([clubId, date])
  @@index([clubId, teamId, date])
  @@index([createdById])
}

model LessonCoach {
  lessonId String @db.Uuid
  coachId  String @db.Uuid

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  coach  Coach  @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@id([lessonId, coachId])
  @@index([coachId])
}

/// A program block placed in a lesson: a snapshot copy of the block's content
/// so later library edits never change past lessons silently.
model LessonItem {
  id                 String   @id @default(uuid(7)) @db.Uuid
  lessonId           String   @db.Uuid
  sectionId          String   @db.Uuid
  sortOrder          Int
  /// Library block this item was copied from; null for one-off items.
  sourceBlockId      String?  @db.Uuid
  /// True once the snapshot was edited and differs from its source block.
  modifiedLocally    Boolean  @default(false)
  title              String
  durationMinutes    Int?
  description        Json?
  rules              Json?
  variations         String[]
  organization       Json?
  material           String[]
  teamCount          Int?
  minParticipants    Int?
  maxParticipants    Int?
  /// Assigned when the block is placed in the lesson (coach or free text).
  responsibleCoachId String?  @db.Uuid
  responsibleText    String?
  customValues       Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lesson           Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  section          Section            @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  sourceBlock      ProgramBlock?      @relation(fields: [sourceBlockId], references: [id], onDelete: SetNull)
  responsibleCoach Coach?             @relation(fields: [responsibleCoachId], references: [id], onDelete: SetNull)
  sketches         LessonItemSketch[]

  @@index([lessonId, sectionId, sortOrder])
  @@index([sourceBlockId])
}

model LessonItemSketch {
  itemId    String @db.Uuid
  assetId   String @db.Uuid
  sortOrder Int    @default(0)

  item  LessonItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  asset Asset      @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([itemId, assetId])
  @@index([assetId])
}

// ---------------------------------------------------------------------------
// Authentication (tables used by Better Auth) and access control
// ---------------------------------------------------------------------------

enum Role {
  /// Everything incl. settings, users, layouts and custom fields.
  ADMIN
  /// Edits the library and lessons, exports and sends PDFs.
  COACH
  /// Read-only: browses blocks and lessons, exports PDFs within a quota, no email.
  READER
}

model User {
  id                String    @id @default(uuid(7)) @db.Uuid
  name              String
  email             String    @unique
  emailVerified     Boolean   @default(false)
  image             String?
  /// Preferred UI language (see src/i18n/config.ts).
  locale            String    @default("de-CH")
  /// Consecutive failed password sign-ins; reset on success.
  failedSignInCount Int       @default(0)
  /// Password sign-in is blocked until this time after too many failures.
  lockedUntil       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions           Session[]
  accounts           Account[]
  passkeys           Passkey[]
  memberships        Membership[]
  invitationsCreated Invitation[] @relation("InvitedBy")
  pdfExports         PdfExport[]
  mailLogs           MailLog[]
  lessonsCreated     Lesson[]     @relation("LessonsCreated")

  @@map("user")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Passkey {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String?
  publicKey    String
  userId       String   @db.Uuid
  credentialID String   @unique
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime @default(now())
  aaguid       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey")
}

model RateLimit {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

/// Role within one team (Riege). Admins need none: they see and edit all.
enum TeamRole {
  /// Plans and edits lessons and blocks of the team, sends emails.
  COACH
  /// Sees the team's lessons and blocks, exports PDFs within the quota.
  READER
}

/// A user's access to a club. ADMIN sees and edits everything. Everyone
/// else gets a role either for all teams (`allTeamsRole`, includes teams
/// created later) or per team (`teams`); other teams are invisible.
/// `role` is the summary used for coarse checks: COACH as soon as the
/// person coaches at least one team, otherwise READER.
model Membership {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  clubId       String    @db.Uuid
  role         Role
  /// Links the user to a coach entry (pre-fills author, "my blocks").
  coachId      String?   @unique @db.Uuid
  /// Team selected in the header; lists are filtered by it. Null = all teams.
  activeTeamId String?   @db.Uuid
  allTeamsRole TeamRole?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  teams      MembershipTeam[]
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  club       Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  coach      Coach?           @relation(fields: [coachId], references: [id], onDelete: SetNull)
  activeTeam Team?            @relation(fields: [activeTeamId], references: [id], onDelete: SetNull)

  @@unique([userId, clubId])
  @@index([clubId])
}

model MembershipTeam {
  membershipId String   @db.Uuid
  teamId       String   @db.Uuid
  role         TeamRole

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([membershipId, teamId])
  @@index([teamId])
}

/// Invite-only access: an admin invites an email address with a role
/// (and team roles, as on Membership). Only a SHA-256 hash of the token
/// is stored.
model Invitation {
  id           String    @id @default(uuid(7)) @db.Uuid
  clubId       String    @db.Uuid
  email        String
  role         Role
  coachId      String?   @db.Uuid
  locale       String    @default("de-CH")
  tokenHash    String    @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  invitedById  String?   @db.Uuid
  allTeamsRole TeamRole?
  createdAt    DateTime  @default(now())

  teams     InvitationTeam[]
  club      Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  coach     Coach?           @relation(fields: [coachId], references: [id], onDelete: SetNull)
  invitedBy User?            @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([clubId, email])
}

model InvitationTeam {
  invitationId String   @db.Uuid
  teamId       String   @db.Uuid
  role         TeamRole

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([invitationId, teamId])
  @@index([teamId])
}

/// One generated PDF. The file itself is never stored: it is streamed to
/// the browser. Rows count against the reader quota and are kept 90 days.
model PdfExport {
  id        String   @id @default(uuid(7)) @db.Uuid
  clubId    String   @db.Uuid
  userId    String   @db.Uuid
  lessonId  String?  @db.Uuid
  createdAt DateTime @default(now())

  club   Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Email
// ---------------------------------------------------------------------------

enum SmtpSecurity {
  /// Implicit TLS from the first byte (usually port 465).
  TLS
  /// Plain connection upgraded with STARTTLS, which is then required (usually 587).
  STARTTLS
  /// Unencrypted. Only accepted when SMTP_REQUIRE_TLS=false (local test server).
  NONE
}

/// The club's outgoing mail server, set by admins. Without it, the server
/// environment (SMTP_*) is used. The password is encrypted (AES-256-GCM,
/// src/lib/crypto/secret-box.ts) and never leaves the server again.
model MailSettings {
  clubId            String       @id @db.Uuid
  host              String
  port              Int
  security          SmtpSecurity
  username          String?
  passwordEncrypted String?
  fromEmail         String
  fromName          String?
  updatedById       String?      @db.Uuid
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

enum MailStatus {
  SENT
  FAILED
}

/// One lesson sent by email: who, to whom, when. Kept 180 days; also the
/// daily sending limit and the source of recipient suggestions.
model MailLog {
  id         String     @id @default(uuid(7)) @db.Uuid
  clubId     String     @db.Uuid
  userId     String     @db.Uuid
  lessonId   String?    @db.Uuid
  recipients String[]
  subject    String
  status     MailStatus
  createdAt  DateTime   @default(now())

  club   Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([clubId, createdAt])
  @@index([userId, createdAt])
  @@index([lessonId, createdAt])
}
