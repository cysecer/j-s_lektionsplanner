# Copy to .env and adjust. Every variable is validated at startup (src/lib/env-schema.ts).

# Public base URL of the app (links in emails, passkey origin). Must be https in production.
APP_URL=http://localhost:3000

# Matches the db service in docker-compose.yml
DATABASE_URL=postgresql://lektionsplaner:lektionsplaner@localhost:5432/lektionsplaner

# --- Authentication ---------------------------------------------------------
# At least 32 characters. Generate: openssl rand -base64 48
AUTH_SECRET=change-me-change-me-change-me-change-me
# Sign out after this many minutes of inactivity / after this many hours in total
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
# Temporary lock after repeated wrong passwords
AUTH_MAX_FAILED_SIGNINS=10
AUTH_LOCKOUT_MINUTES=15
# Behind a reverse proxy: its IP/CIDR (comma-separated), so rate limits see real client IPs
TRUSTED_PROXIES=

# --- Email (SMTP) -----------------------------------------------------------
# Development: Mailpit from docker-compose (web UI http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
# true for implicit TLS (port 465); otherwise STARTTLS is negotiated
SMTP_SECURE=false
# Mailpit has no TLS; keep "true" (the default) for any real mail server
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Lektionsplaner <noreply@localhost>"
